# Copia este archivo como `.env.local` y rellena los valores.
# `.env.local` está en .gitignore: nunca se commitea.

# URL del sitio. Solo hace falta definirla en previews, donde el dominio no es
# el de producción; si se deja vacía se usa https://linkaurora.com
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4. El ID de producción ya está en src/config/site.ts y se
# activa solo en builds de producción, así que normalmente esto se deja vacío.
# Defínelo para apuntar a otra propiedad, o ponlo en blanco explícitamente en
# los despliegues de preview para que no manden datos a la propiedad real.
NEXT_PUBLIC_GA_ID=

# Google Search Console — solo si se verifica con etiqueta HTML.
# El dominio linkaurora.com ya está verificado por DNS, así que va vacío.
# Pega únicamente el `content` de la meta, no la etiqueta entera.
GOOGLE_SITE_VERIFICATION=
